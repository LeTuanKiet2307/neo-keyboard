    android:settingsActivity="app.neokeyboard.ui.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:icon="@drawable/ic_ime"
        android:imeSubtypeExtraValue="Telex=true"
        android:imeSubtypeLocale="vi"
        android:imeSubtypeMode="keyboard"
